rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Strict Admin Verifier: Only lifet4542@gmail.com is authorized
    function isAdmin() {
      return request.auth != null && request.auth.token.email.lower() == 'lifet4542@gmail.com';
    }

    // 1. Theme Studio (Public read for all browsers, authenticated write for admin)
    match /browser_theme/{themeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Browser Notices & What's New Broadcast
    match /browser_notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Browser Device Installations (Heartbeat counter)
    match /browser_installations/{deviceId} {
      allow read, write: if true;
    }

    // 4. Feedback Submissions (Any user can submit, only lifet4542@gmail.com can manage)
    match /feedback_submissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Default deny for unlisted collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
